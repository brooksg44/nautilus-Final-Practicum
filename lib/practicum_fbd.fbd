(* Function block diagram implementation of the practicum controller. It
   follows control.st section by section and must stay behaviourally
   identical to it (the acceptance tests run every scenario in ST, LD and
   FBD).

   Statements run top to bottom, and several networks write MainStep,
   AutoStep and BeltSpeedRef in turn, as the ST does. Conditions that must
   be taken before such a write are stored in variables (WasEStopped,
   AutoStepAtScanStart); a wire would be re-read after the write.

   Every stored bit is built from NOT ResetState, directly or through
   ControlOn, so while ResetState is TRUE every BOOL output drops and the
   shared totals, step numbers and speeds are left alone. *)
FUNCTION_BLOCK PracticumFBD
VAR_EXTERNAL
    AtExit : BOOL;
    AutoSS : BOOL;
    RejectDiffuseSensor : BOOL;
    DecSpdX10 : BOOL;
    DecSpdX100 : BOOL;
    EmergencyStop : BOOL;
    EmergencyStop2 : BOOL;
    FIOPaused : BOOL;
    FIOReset : BOOL;
    FIORunning : BOOL;
    IncSpdX100 : BOOL;
    IncSpdX10 : BOOL;
    LocalControlPanel : BOOL;
    ManualSS : BOOL;
    RejPushBackLimit : BOOL;
    RejPushFrontLimit : BOOL;
    RemoteControlPanel : BOOL;
    Reset : BOOL;
    Start : BOOL;
    Stop : BOOL;
    ClassifyDefuseSensor : BOOL;
    BaseSorterBeltCCWManPB : BOOL;
    BaseSorterBeltCWManPB : BOOL;
    BaseSorterBeltTurnManPB : BOOL;
    LidSorterBeltCCWManPB : BOOL;
    LidSorterBeltCWManPB : BOOL;
    LidSorterBeltTurnManPB : BOOL;
    RawSorterBeltCCWManPB : BOOL;
    RawSorterBeltCWManPB : BOOL;
    RawSorterBeltTurnManPB : BOOL;
    BeltConveyor4mManPB : BOOL;
    RejectPusherManPB : BOOL;
    SendSortPB : BOOL;
    SendRejectPB : BOOL;
    Reset2PB : BOOL;
    VisionSensor1 : INT;
    BaseLightInd : BOOL;
    BaseSorterBeltCCW : BOOL;
    BaseSorterBeltCW : BOOL;
    BaseSorterBeltTurn : BOOL;
    DecSpdX10Light : BOOL;
    DecSpdX100Light : BOOL;
    Emitter : BOOL;
    Spare : BOOL;
    IncSpdX1Light : BOOL;
    IncSpdX10Light : BOOL;
    LabPLCRunning : BOOL;
    LidLightInd : BOOL;
    LidSorterBeltCCW : BOOL;
    LidSorterBeltCW : BOOL;
    LidSorterBeltTurn : BOOL;
    LocalPanelActive : BOOL;
    RawLightInd : BOOL;
    RawSorterBeltTurn : BOOL;
    RawSorterBeltCCW : BOOL;
    RawSorterBeltCW : BOOL;
    RejectPusher : BOOL;
    RemotePanelActive : BOOL;
    Remover1 : BOOL;
    Remover2 : BOOL;
    Remover3 : BOOL;
    ControlOnPL : BOOL;
    SkidPLCRunning : BOOL;
    StartPL : BOOL;
    StopBlade : BOOL;
    StopPL : BOOL;
    WarningLight1 : BOOL;
    AutoPL : BOOL;
    RawSorterBeltCCWPL : BOOL;
    RawSorterBeltCWPL : BOOL;
    RawSorterBeltTurnPL : BOOL;
    BaseSorterBeltCCWPL : BOOL;
    BaseSorterBeltCWPL : BOOL;
    BaseSorterBeltTurnPL : BOOL;
    LidSorterBeltCCWPL : BOOL;
    LidSorterBeltCWPL : BOOL;
    LidSorterBeltTurnPL : BOOL;
    ManualPL : BOOL;
    BeltConveyor4mPL : BOOL;
    RejectPusherPL : BOOL;
    ControlOnPL2 : BOOL;
    EStoppedPL : BOOL;
    RunningPL : BOOL;
    BaseCounter : INT;
    BeltConveyor4mSpeed : REAL;
    BeltSpeedRef : INT;
    LidCounter : INT;
    ProductionRate : INT;
    RawCounter : INT;
    BeltConveyor4mSpeed2 : REAL;
    RejectFlag : BOOL;
    EmitFlag : BOOL;
    RawFlag : BOOL;
    BaseFlag : BOOL;
    LidFlag : BOOL;
    LastBeltRefSpeed : INT;
    TargetBeltSpeed : REAL;
    ScanDtS : REAL;
    MainStep : INT;
    AutoStep : INT;
    Mode : INT;
END_VAR
VAR_INPUT
    ResetState : BOOL;
END_VAR
VAR CONSTANT
    BlinkPeriodS : REAL := 1.0;
    BlinkOnS : REAL := 0.5;
    WarningTimeS : REAL := 3.0;
    EmitPulseS : REAL := 0.5;
    SortSettleS : REAL := 0.5;
    ResetHoldS : REAL := 5.0;
    MetalCodeMin : INT := 7;
    MetalCodeMax : INT := 9;
    ClassifySpeed : INT := 60;
    JogSpeed : INT := 60;
    MaxBeltSpeed : INT := 300;
END_VAR
VAR
    ClockS : REAL;
    Blink : BOOL;
    AutoElapsed : REAL;
    EmitRemaining : REAL;
    SortElapsed : REAL;
    ResetHeld : REAL;
    PrevMode : INT;
    AutoStepAtScanStart : INT;
    SafetyHealthy : BOOL;
    WasEStopped : BOOL;
    WasAwaitingReset : BOOL;
    ControlOn : BOOL;
    ManualMode : BOOL;
    AutoMode : BOOL;
    ModeChanged : BOOL;
    Warning : BOOL;
    WarningDone : BOOL;
    Classifying : BOOL;
    MetalDetected : BOOL;
    RejectCall : BOOL;
    SortCall : BOOL;
    SortSettling : BOOL;
    RawDiverting : BOOL;
    BaseDiverting : BOOL;
    LidDiverting : BOOL;
    ManRawCCW : BOOL;
    ManRawCW : BOOL;
    ManBaseCCW : BOOL;
    ManBaseCW : BOOL;
    ManLidCCW : BOOL;
    ManLidCW : BOOL;
END_VAR

FBD
  NETWORK 'Blink clock'
  // Free-running clock behind every flashing pilot light: on for the first
  // half of each period. A reset restarts it.
  ClockS := SEL(ResetState, ADD(ClockS, ScanDtS), 0.0)
  periodOver = GE(ClockS, BlinkPeriodS)
  ClockS := SEL(periodOver, ClockS, SUB(ClockS, BlinkPeriodS))
  Blink := AND(NOT ResetState, LT(ClockS, BlinkOnS))

  NETWORK 'Main chart X1/X2/X3'
  // Stop and both emergency stops are NC: TRUE = healthy. FIOReset restarts
  // the sequence but keeps the totals. The two Was... bits remember the step
  // before the statements below move it, so one transition fires per scan.
  SafetyHealthy := AND(NOT ResetState, EmergencyStop, EmergencyStop2, NOT FIOReset)
  WasEStopped := AND(SafetyHealthy, EQ(MainStep, 1))
  WasAwaitingReset := AND(SafetyHealthy, Stop, EQ(MainStep, 2))
  tripped = AND(NOT ResetState, NOT SafetyHealthy)
  MainStep := SEL(tripped, MainStep, 1)
  estopCleared = AND(WasEStopped, Stop)
  MainStep := SEL(estopCleared, MainStep, 2)
  stopPressed = AND(SafetyHealthy, NOT WasEStopped, NOT Stop)
  MainStep := SEL(stopPressed, MainStep, 2)
  // Reset is accepted only with the conveyor clear and the exit made.
  resetPressed = OR(Reset, Reset2PB)
  resetAccepted = AND(WasAwaitingReset, resetPressed, NOT ClassifyDefuseSensor, NOT RejectDiffuseSensor, AtExit)
  MainStep := SEL(resetAccepted, MainStep, 3)
  // X3 is the only motion permissive; the blinking pilot light never is.
  ControlOn := AND(NOT ResetState, EQ(MainStep, 3))

  NETWORK 'Control pilot lights'
  // Control-on is steady in X3 and flashes while waiting; e-stopped flashes
  // in X1.
  ControlOnPL := OR(ControlOn, Blink)
  ControlOnPL2 := ControlOnPL
  StopPL := AND(NOT ResetState, NOT ControlOn)
  EStoppedPL := AND(Blink, EQ(MainStep, 1))

  NETWORK 'Mode selection X4/X5'
  // A mode needs control on and an unambiguous selector; otherwise Mode is 0.
  ManualMode := AND(ControlOn, ManualSS, NOT AutoSS)
  AutoMode := AND(ControlOn, AutoSS, NOT ManualSS)
  ManualPL := ManualMode
  AutoPL := AutoMode
  manualOrNone = SEL(ManualMode, 0, 4)
  selectedMode = SEL(AutoMode, manualOrNone, 5)
  Mode := SEL(ResetState, selectedMode, Mode)

  NETWORK 'Mode change'
  // Leaving a mode deactivates its child chart: the new mode starts stopped,
  // at the first automatic step. A reset clears the same timers.
  ModeChanged := AND(NOT ResetState, NE(Mode, PrevMode))
  restart = OR(ResetState, ModeChanged)
  BeltSpeedRef := SEL(ModeChanged, BeltSpeedRef, 0)
  LastBeltRefSpeed := SEL(ModeChanged, LastBeltRefSpeed, 0)
  AutoStep := SEL(ModeChanged, AutoStep, 16)
  AutoElapsed := SEL(restart, AutoElapsed, 0.0)
  EmitRemaining := SEL(restart, EmitRemaining, 0.0)
  SortElapsed := SEL(restart, SortElapsed, 0.0)

  NETWORK 'Operator belt speed'
  // +/-10 and +/-100 cm/s per press with control on, clamped 0..300. A change
  // becomes the speed to return to after classifying.
  inc10 : R_TRIG(CLK := IncSpdX10)
  inc100 : R_TRIG(CLK := IncSpdX100)
  dec10 : R_TRIG(CLK := DecSpdX10)
  dec100 : R_TRIG(CLK := DecSpdX100)
  up10 = AND(ControlOn, inc10.Q)
  BeltSpeedRef := SEL(up10, BeltSpeedRef, ADD(BeltSpeedRef, 10))
  up100 = AND(ControlOn, inc100.Q)
  BeltSpeedRef := SEL(up100, BeltSpeedRef, ADD(BeltSpeedRef, 100))
  down10 = AND(ControlOn, dec10.Q)
  BeltSpeedRef := SEL(down10, BeltSpeedRef, SUB(BeltSpeedRef, 10))
  down100 = AND(ControlOn, dec100.Q)
  BeltSpeedRef := SEL(down100, BeltSpeedRef, SUB(BeltSpeedRef, 100))
  BeltSpeedRef := SEL(ControlOn, BeltSpeedRef, LIMIT(0, BeltSpeedRef, MaxBeltSpeed))
  speedPressed = OR(inc10.Q, inc100.Q, dec10.Q, dec100.Q)
  speedChanged = AND(ControlOn, speedPressed)
  LastBeltRefSpeed := SEL(speedChanged, LastBeltRefSpeed, BeltSpeedRef)

  NETWORK 'Automatic: start and warning X16/X21/X20'
  // Every automatic transition tests the step the scan started in, so one
  // step moves per scan. Start begins a three second warning; when it ends
  // the first part is emitted and the belt takes its remembered speed.
  AutoStepAtScanStart := SEL(AutoMode, AutoStepAtScanStart, AutoStep)
  armed = AND(AutoMode, EQ(AutoStepAtScanStart, 16))
  AutoStep := SEL(armed, AutoStep, 21)
  startCall = AND(AutoMode, EQ(AutoStepAtScanStart, 21), Start)
  AutoStep := SEL(startCall, AutoStep, 20)
  AutoElapsed := SEL(startCall, AutoElapsed, 0.0)
  Warning := AND(AutoMode, EQ(AutoStepAtScanStart, 20))
  WarningLight1 := AND(Warning, NOT Blink)
  AutoElapsed := SEL(Warning, AutoElapsed, ADD(AutoElapsed, ScanDtS))
  WarningDone := AND(Warning, GE(AutoElapsed, WarningTimeS))
  AutoStep := SEL(WarningDone, AutoStep, 19)
  EmitRemaining := SEL(WarningDone, EmitRemaining, EmitPulseS)
  BeltSpeedRef := SEL(WarningDone, BeltSpeedRef, LastBeltRefSpeed)
  // The running light seals in until automatic is left.
  stillAuto = AND(AutoMode, NOT ModeChanged)
  RunningPL := AND(stillAuto, OR(WarningDone, RunningPL))

  NETWORK 'Automatic: emit and classify X19/X22'
  // A part reaching the classifier slows the belt. Metal (codes 7..9) is
  // always rejected, and reject wins if the operator presses both commands.
  EmitFlag := AND(AutoMode, EQ(AutoStepAtScanStart, 19))
  partEdge : R_TRIG(CLK := ClassifyDefuseSensor)
  partArrived = AND(EmitFlag, partEdge.Q)
  LastBeltRefSpeed := SEL(partArrived, LastBeltRefSpeed, BeltSpeedRef)
  BeltSpeedRef := SEL(partArrived, BeltSpeedRef, ClassifySpeed)
  AutoStep := SEL(partArrived, AutoStep, 22)
  Classifying := AND(AutoMode, EQ(AutoStepAtScanStart, 22))
  MetalDetected := AND(GE(VisionSensor1, MetalCodeMin), LE(VisionSensor1, MetalCodeMax))
  RejectCall := AND(Classifying, OR(SendRejectPB, MetalDetected))
  SortCall := AND(Classifying, NOT RejectCall, SendSortPB)
  AutoStep := SEL(RejectCall, AutoStep, 25)

  NETWORK 'Automatic: choose the sorter X24/X27/X28'
  // The vision code picks the sorter; the part is counted and the belt
  // resumes its speed. An unknown code waits in X22.
  isRaw = OR(EQ(VisionSensor1, 1), EQ(VisionSensor1, 4))
  toRaw = AND(SortCall, isRaw)
  AutoStep := SEL(toRaw, AutoStep, 24)
  RawCounter := SEL(toRaw, RawCounter, ADD(RawCounter, 1))
  BeltSpeedRef := SEL(toRaw, BeltSpeedRef, LastBeltRefSpeed)
  isBase = OR(EQ(VisionSensor1, 3), EQ(VisionSensor1, 6))
  toBase = AND(SortCall, isBase)
  AutoStep := SEL(toBase, AutoStep, 27)
  BaseCounter := SEL(toBase, BaseCounter, ADD(BaseCounter, 1))
  BeltSpeedRef := SEL(toBase, BeltSpeedRef, LastBeltRefSpeed)
  isLid = OR(EQ(VisionSensor1, 2), EQ(VisionSensor1, 5))
  toLid = AND(SortCall, isLid)
  AutoStep := SEL(toLid, AutoStep, 28)
  LidCounter := SEL(toLid, LidCounter, ADD(LidCounter, 1))
  BeltSpeedRef := SEL(toLid, BeltSpeedRef, LastBeltRefSpeed)

  NETWORK 'Automatic: part leaves the sorter'
  // Diverting ends when the part leaves the exit sensor; once the sensor is
  // made again and a settling time has passed, the next part is emitted.
  atSorter = OR(EQ(AutoStepAtScanStart, 24), EQ(AutoStepAtScanStart, 27), EQ(AutoStepAtScanStart, 28))
  leaving = AND(AutoMode, atSorter, NOT AtExit)
  AutoStep := SEL(leaving, AutoStep, ADD(AutoStep, 100))
  pastSorter = OR(EQ(AutoStepAtScanStart, 124), EQ(AutoStepAtScanStart, 127), EQ(AutoStepAtScanStart, 128))
  cleared = AND(AutoMode, pastSorter, AtExit)
  AutoStep := SEL(cleared, AutoStep, ADD(AutoStep, 100))
  SortElapsed := SEL(cleared, SortElapsed, 0.0)
  settleStep = OR(EQ(AutoStepAtScanStart, 224), EQ(AutoStepAtScanStart, 227), EQ(AutoStepAtScanStart, 228))
  SortSettling := AND(AutoMode, settleStep)
  SortElapsed := SEL(SortSettling, SortElapsed, ADD(SortElapsed, ScanDtS))
  sortDone = AND(SortSettling, GE(SortElapsed, SortSettleS))
  AutoStep := SEL(sortDone, AutoStep, 19)
  EmitRemaining := SEL(sortDone, EmitRemaining, EmitPulseS)
  BeltSpeedRef := SEL(sortDone, BeltSpeedRef, LastBeltRefSpeed)

  NETWORK 'Automatic: reject X25/X85/X86'
  // Stop the belt with the part in front of the pusher, push until the front
  // limit, and emit the next part once the pusher is home.
  atPusher = AND(AutoMode, EQ(AutoStepAtScanStart, 25), RejectDiffuseSensor)
  AutoStep := SEL(atPusher, AutoStep, 85)
  BeltSpeedRef := SEL(atPusher, BeltSpeedRef, 0)
  pushedOut = AND(AutoMode, EQ(AutoStepAtScanStart, 85), RejPushFrontLimit)
  AutoStep := SEL(pushedOut, AutoStep, 86)
  pusherHome = AND(AutoMode, EQ(AutoStepAtScanStart, 86), RejPushBackLimit)
  AutoStep := SEL(pusherHome, AutoStep, 19)
  EmitRemaining := SEL(pusherHome, EmitRemaining, EmitPulseS)
  BeltSpeedRef := SEL(pusherHome, BeltSpeedRef, LastBeltRefSpeed)

  NETWORK 'Automatic: step flags and emitter'
  // The flags follow the step this scan ended in. The emitter runs for as
  // long as its pulse has time left.
  rawActive = OR(EQ(AutoStep, 24), EQ(AutoStep, 124), EQ(AutoStep, 224))
  RawFlag := AND(AutoMode, rawActive)
  baseActive = OR(EQ(AutoStep, 27), EQ(AutoStep, 127), EQ(AutoStep, 227))
  BaseFlag := AND(AutoMode, baseActive)
  lidActive = OR(EQ(AutoStep, 28), EQ(AutoStep, 128), EQ(AutoStep, 228))
  LidFlag := AND(AutoMode, lidActive)
  rejectActive = OR(EQ(AutoStep, 25), EQ(AutoStep, 85))
  RejectFlag := AND(AutoMode, rejectActive)
  Emitter := AND(AutoMode, GT(EmitRemaining, 0.0))
  EmitRemaining := SEL(Emitter, EmitRemaining, SUB(EmitRemaining, ScanDtS))

  NETWORK 'Manual belt jog'
  // Push-on / push-off: latching on runs the belt at jog speed, latching off
  // stops it.
  beltJog : ToggleLatch(IN := ManualMode, Press := BeltConveyor4mManPB)
  jogOn = AND(beltJog.Flipped, beltJog.Q)
  BeltSpeedRef := SEL(jogOn, BeltSpeedRef, JogSpeed)
  jogOff = AND(beltJog.Flipped, NOT beltJog.Q)
  BeltSpeedRef := SEL(jogOff, BeltSpeedRef, 0)

  NETWORK 'Raw sorter: divert, then manual jog'
  // X24 diverts in automatic; in manual each button is push-on / push-off
  // and CW and CCW refuse each other. The latches drop on leaving manual.
  RawDiverting := AND(AutoMode, EQ(AutoStep, 24))
  RawLightInd := RawDiverting
  rawCcw : ToggleLatch(IN := ManualMode, Press := RawSorterBeltCCWManPB, Inhibit := ManRawCW)
  ManRawCCW := rawCcw.Q
  rawCw : ToggleLatch(IN := ManualMode, Press := RawSorterBeltCWManPB, Inhibit := ManRawCCW)
  ManRawCW := rawCw.Q
  rawTurn : ToggleLatch(IN := ManualMode, Press := RawSorterBeltTurnManPB)
  RawSorterBeltCCW := ManRawCCW
  RawSorterBeltCW := OR(RawDiverting, ManRawCW)
  RawSorterBeltTurn := OR(RawDiverting, rawTurn.Q)
  RawSorterBeltCCWPL := RawSorterBeltCCW
  RawSorterBeltCWPL := RawSorterBeltCW
  RawSorterBeltTurnPL := RawSorterBeltTurn

  NETWORK 'Base sorter: divert, then manual jog'
  // X27 diverts in automatic; in manual each button is push-on / push-off
  // and CW and CCW refuse each other. The latches drop on leaving manual.
  BaseDiverting := AND(AutoMode, EQ(AutoStep, 27))
  BaseLightInd := BaseDiverting
  baseCcw : ToggleLatch(IN := ManualMode, Press := BaseSorterBeltCCWManPB, Inhibit := ManBaseCW)
  ManBaseCCW := baseCcw.Q
  baseCw : ToggleLatch(IN := ManualMode, Press := BaseSorterBeltCWManPB, Inhibit := ManBaseCCW)
  ManBaseCW := baseCw.Q
  baseTurn : ToggleLatch(IN := ManualMode, Press := BaseSorterBeltTurnManPB)
  BaseSorterBeltCCW := ManBaseCCW
  BaseSorterBeltCW := OR(BaseDiverting, ManBaseCW)
  BaseSorterBeltTurn := OR(BaseDiverting, baseTurn.Q)
  BaseSorterBeltCCWPL := BaseSorterBeltCCW
  BaseSorterBeltCWPL := BaseSorterBeltCW
  BaseSorterBeltTurnPL := BaseSorterBeltTurn

  NETWORK 'Lid sorter: divert, then manual jog'
  // X28 diverts in automatic; in manual each button is push-on / push-off
  // and CW and CCW refuse each other. The latches drop on leaving manual.
  LidDiverting := AND(AutoMode, EQ(AutoStep, 28))
  LidLightInd := LidDiverting
  lidCcw : ToggleLatch(IN := ManualMode, Press := LidSorterBeltCCWManPB, Inhibit := ManLidCW)
  ManLidCCW := lidCcw.Q
  lidCw : ToggleLatch(IN := ManualMode, Press := LidSorterBeltCWManPB, Inhibit := ManLidCCW)
  ManLidCW := lidCw.Q
  lidTurn : ToggleLatch(IN := ManualMode, Press := LidSorterBeltTurnManPB)
  LidSorterBeltCCW := ManLidCCW
  LidSorterBeltCW := OR(LidDiverting, ManLidCW)
  LidSorterBeltTurn := OR(LidDiverting, lidTurn.Q)
  LidSorterBeltCCWPL := LidSorterBeltCCW
  LidSorterBeltCWPL := LidSorterBeltCW
  LidSorterBeltTurnPL := LidSorterBeltTurn

  NETWORK 'Reject pusher'
  // Automatic push at X85, or the manual push-on / push-off latch.
  rejectJog : ToggleLatch(IN := ManualMode, Press := RejectPusherManPB)
  pushing = AND(AutoMode, EQ(AutoStep, 85))
  RejectPusher := OR(pushing, rejectJog.Q)
  RejectPusherPL := RejectPusher

  NETWORK 'Manual totals reset'
  // Holding Reset five continuous seconds in manual clears the three totals;
  // releasing it or leaving manual restarts the hold.
  holding = AND(ManualMode, Reset)
  ResetHeld := SEL(holding, 0.0, ADD(ResetHeld, ScanDtS))
  totalsClear = AND(ManualMode, GE(ResetHeld, ResetHoldS))
  RawCounter := SEL(totalsClear, RawCounter, 0)
  BaseCounter := SEL(totalsClear, BaseCounter, 0)
  LidCounter := SEL(totalsClear, LidCounter, 0)

  NETWORK 'Belt drive'
  // Output arbitration: no mode, no motion. Clamp, then scale 0..300 cm/s to
  // the drive's 0..10 V on both analog channels.
  noMode = AND(NOT ResetState, EQ(Mode, 0))
  BeltSpeedRef := SEL(noMode, BeltSpeedRef, 0)
  BeltSpeedRef := SEL(ResetState, LIMIT(0, BeltSpeedRef, MaxBeltSpeed), BeltSpeedRef)
  volts = DIV(MUL(BeltSpeedRef, 10.0), 300.0)
  TargetBeltSpeed := SEL(ResetState, volts, TargetBeltSpeed)
  BeltConveyor4mSpeed := SEL(ResetState, TargetBeltSpeed, BeltConveyor4mSpeed)
  BeltConveyor4mSpeed2 := SEL(ResetState, TargetBeltSpeed, BeltConveyor4mSpeed2)
  BeltConveyor4mPL := AND(NOT ResetState, GT(BeltSpeedRef, 0))
  // Flashes while automatic waits for Start, steady once running.
  StartPL := AND(AutoMode, OR(RunningPL, Blink))

  NETWORK 'Scene support outputs'
  // Outputs the scene needs that are absent from the chart's actions. The
  // stop blade and the spare are never used.
  Remover1 := NOT ResetState
  Remover2 := NOT ResetState
  Remover3 := NOT ResetState
  LabPLCRunning := Blink
  SkidPLCRunning := Blink
  LocalPanelActive := AND(NOT ResetState, LocalControlPanel)
  RemotePanelActive := AND(NOT ResetState, RemoteControlPanel)
  IncSpdX1Light := AND(NOT ResetState, IncSpdX100)
  IncSpdX10Light := AND(NOT ResetState, IncSpdX10)
  DecSpdX10Light := AND(NOT ResetState, DecSpdX10)
  DecSpdX100Light := AND(NOT ResetState, DecSpdX100)
  StopBlade := AND(ResetState, StopBlade)
  Spare := AND(ResetState, Spare)

  NETWORK 'End of scan'
  // No rate is calculated. Remember the mode for the next scan's change
  // detection.
  ProductionRate := SEL(ResetState, 0, ProductionRate)
  PrevMode := SEL(ResetState, Mode, 0)
END_FBD
END_FUNCTION_BLOCK
