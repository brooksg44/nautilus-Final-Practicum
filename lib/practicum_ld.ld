  RUNG r229_PrevLidCCW
    [ /ResetState LidSorterBeltCCWManPB | ResetState PrevLidCCW ] ( PrevLidCCW )
  RUNG r230_PrevLidCW
    [ /ResetState LidSorterBeltCWManPB | ResetState PrevLidCW ] ( PrevLidCW )
  RUNG r231_PrevLidTurn
